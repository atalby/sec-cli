#!/usr/bin/env bash
# bin/sec-migrator: Universal Fault-Tolerant Vault-to-Vault Secret Migration Engine with Transaction State & Undo
set -euo pipefail

CACHE_DIR="$HOME/.cache/bitwarden"
TX_FILE="$CACHE_DIR/migration_transaction.json"
mkdir -p "$CACHE_DIR"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Ensure BW_SESSION is populated
if [[ -z "${BW_SESSION:-}" ]]; then
    if [[ -f "$HOME/.cache/bitwarden/session" ]] && [[ -s "$HOME/.cache/bitwarden/session" ]]; then
        export BW_SESSION="$(cat "$HOME/.cache/bitwarden/session")"
    fi
fi

usage() {
    echo "Fleet Secret Manager Migration Engine (sec migrate)"
    echo ""
    echo "Usage:"
    echo "  sec migrate --from <src_backend> --to <dst_backend> [--plan|--dry-run|--apply]"
    echo "  sec migrate --undo                                    Rollback partially migrated items"
    echo ""
    echo "Supported Migration Source / Target Backends:"
    echo "  bitwarden (bw) | bws | 1password (op) | infisical | vault"
    exit 0
}

usage_error() {
    echo "[ERROR] $1" >&2
    echo "Run 'sec migrate --help' for usage." >&2
    exit 2
}

# Handle Undo/Rollback
if [[ "${1:-}" == "--undo" || "${1:-}" == "undo" || "${1:-}" == "revert" ]]; then
    echo "[INFO] Reverting Last Secret Migration Operation"
    if [[ ! -f "$TX_FILE" ]]; then
        echo "[ERROR] No active migration transaction log found ($TX_FILE)." >&2
        exit 1
    fi

    if ! dst="$(jq -r '.dstBackend // "op"' "$TX_FILE" 2>/dev/null)"; then
        echo "[ERROR] corrupt or unreadable migration transaction log ($TX_FILE). Undo is blocked; inspect or delete the file manually." >&2
        exit 1
    fi
    if ! created_items="$(jq -c '.createdItems[]?' "$TX_FILE" 2>/dev/null)"; then
        echo "[ERROR] corrupt or unreadable migration transaction log ($TX_FILE). Undo is blocked; inspect or delete the file manually." >&2
        exit 1
    fi

    if [[ -z "$created_items" ]]; then
        echo "[INFO] Transaction log contains zero created items."
        rm -f "$TX_FILE"
        exit 0
    fi

    while read -r item; do
        if [[ -z "$item" ]]; then continue; fi
        id="$(echo "$item" | jq -r '.id // empty')"
        name="$(echo "$item" | jq -r '.name // empty')"

        echo "[INFO] Removing migrated item \"$name\" ($id) from target vault '$dst'..."
        case "$dst" in
            1password|op)  op item delete "$id" --archive 2>/dev/null || true ;;
            bitwarden|bw)  bw delete item "$id" 2>/dev/null || true ;;
            bws)           bws secret delete "$id" 2>/dev/null || true ;;
        esac
    done <<< "$created_items"

    rm -f "$TX_FILE"
    echo "[ OK ] Secret Migration Rollback Successfully Completed"
    exit 0
fi

SRC=""
DST=""
MODE="plan"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help|help) usage ;;
        --from)
            if [[ $# -lt 2 ]]; then usage_error "sec migrate --from requires a <src_backend>"; fi
            SRC="$2"; shift 2 ;;
        --to)
            if [[ $# -lt 2 ]]; then usage_error "sec migrate --to requires a <dst_backend>"; fi
            DST="$2"; shift 2 ;;
        --apply) MODE="apply"; shift ;;
        --dry-run|--plan) MODE="plan"; shift ;;
        *) usage_error "unknown migrate flag: '$1'" ;;
    esac
done

if [[ -z "$SRC" || -z "$DST" ]]; then
    usage_error "sec migrate requires both --from <src_backend> and --to <dst_backend>"
fi

case "$DST" in
    1password|1pass|op|bitwarden|bw|bws|infisical|vault) ;;
    *) echo "[ERROR] Destination backend '$DST' not supported for bulk migration." >&2; exit 1 ;;
esac

echo "[INFO] Fleet Secret Vault Migration ($SRC -> $DST, Mode: $MODE)"

# 1. Fetch Source Items into Memory
fetch_source_items() {
    case "$SRC" in
        bitwarden|bw)
            if ! BW_SESSION="${BW_SESSION:-}" bw sync --nostatus >/dev/null 2>&1; then
                echo "[ERROR] Bitwarden vault is locked. Run 'sec unlock' first." >&2
                exit 1
            fi
            bw list items 2>/dev/null || echo "[]"
            ;;
        1password|1pass|op)
            op item list --format=json 2>/dev/null || echo "[]"
            ;;
        bws)
            bws secret list 2>/dev/null || echo "[]"
            ;;
        *)
            echo "[ERROR] Source backend '$SRC' not supported for bulk migration." >&2
            exit 1
            ;;
    esac
}

items_json="$(fetch_source_items)"
count="$(echo "$items_json" | jq '. | length' 2>/dev/null || echo 0)"

if [[ "$count" -eq 0 ]]; then
    echo "[INFO] Zero items found in source backend '$SRC'."
    exit 0
fi

echo "[INFO] Discovered $count secret items in source vault '$SRC'."
echo ""

# 2. Plan or Apply Migration
migrated_count=0
created_log="[]"

# Trap errors during apply
trap_error() {
    local failed_item="$1"
    echo "" >&2
    echo "[ERROR] Migration failed while transferring item \"$failed_item\"." >&2
    echo "[INFO] SOURCE VAULT '$SRC' REMAINS 100% INTACT & UNTOUCHED." >&2

    # Save transaction log up to failure point
    save_tx

    echo "[ OK ] Saved migration transaction state log to $TX_FILE." >&2
    echo "[INFO] To rollback created items from '$DST', run 'sec migrate --undo'." >&2
    exit 1
}

save_tx() {
    jq -n --arg src "$SRC" --arg dst "$DST" --argjson items "$created_log" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{srcBackend: $src, dstBackend: $dst, timestamp: $ts, createdItems: $items}' > "$TX_FILE"
    chmod 600 "$TX_FILE" 2>/dev/null || true
}

if [[ "$MODE" == "apply" ]]; then
    trap 'trap_error "interrupted"' INT TERM

    if [[ -f "$TX_FILE" ]]; then
        existing_items="$(jq -r '.createdItems // [] | length' "$TX_FILE" 2>/dev/null || echo 0)"
        if [[ "${existing_items:-0}" -gt 0 ]]; then
            echo "[ERROR] unresolved migration transaction at $TX_FILE ($existing_items created items). Run 'sec migrate --undo' first." >&2
            exit 1
        fi
    fi
fi

while read -r item; do
    if [[ -z "$item" ]]; then continue; fi
    name="$(echo "$item" | jq -r '.name // .title // .key // empty')"
    if [[ -z "$name" ]]; then continue; fi

    val="$(echo "$item" | jq -r '.notes // .login.password // .value // empty')"

    if [[ "$MODE" == "plan" ]]; then
        echo "  [PLAN MIGRATE] \"$name\" -> Target: $DST"
        migrated_count=$((migrated_count + 1))
    elif [[ "$MODE" == "apply" ]]; then
        echo "  [MIGRATING] \"$name\" -> Target: $DST..."
        created_id=""

        case "$DST" in
            1password|1pass|op)
                op_template="$(SECVAL="$val" jq -n --arg title "$name" '{title: $title, category: "PASSWORD", fields: [{id: "password", type: "CONCEALED", purpose: "PASSWORD", label: "password", password_details: {strength: ""}, value: env.SECVAL}]}')"
                res="$(printf '%s' "$op_template" | op item create - --format=json 2>/dev/null || true)"
                created_id="$(echo "$res" | jq -r '.id // empty')"
                if [[ -z "$created_id" ]]; then trap_error "$name"; fi
                ;;
            bitwarden|bw)
                encoded="$(bw get template item 2>/dev/null | SECVAL="$val" jq --arg name "$name" '.name=$name | .type=1 | .login.password=env.SECVAL' | bw encode 2>/dev/null || true)"
                if [[ -n "$encoded" ]]; then
                    res="$(printf '%s' "$encoded" | bw create item 2>/dev/null || true)"
                    created_id="$(echo "$res" | jq -r '.id // empty')"
                fi
                if [[ -z "$created_id" ]]; then trap_error "$name"; fi
                ;;
            bws)
                proj_id="$(bws project list 2>/dev/null | jq -r '.[0].id // empty')"
                if [[ -n "$proj_id" && -n "$val" ]]; then
                    res="$(bws secret create "$name" "$val" "$proj_id" 2>/dev/null || true)"
                    created_id="$(echo "$res" | jq -r '.id // empty')"
                fi
                if [[ -z "$created_id" ]]; then trap_error "$name"; fi
                ;;
            infisical)
                if [[ -n "$val" ]]; then
                    inf_tmp="$(mktemp "${TMPDIR:-/tmp}/sec-inf-XXXXXX")"
                    chmod 600 "$inf_tmp"
                    printf '%s' "$val" >"$inf_tmp"
                    if infisical secrets set "$name=@$inf_tmp" >/dev/null 2>&1; then
                        rm -f "$inf_tmp"
                        created_id="$name"
                    else
                        rm -f "$inf_tmp"
                        trap_error "$name"
                    fi
                fi
                ;;
            vault)
                if [[ -n "$val" ]]; then
                    if printf '%s' "$val" | vault kv put "secret/data/$name" value=- >/dev/null 2>&1; then
                        created_id="$name"
                    else
                        trap_error "$name"
                    fi
                fi
                ;;
        esac

        if [[ -z "$created_id" ]]; then trap_error "$name"; fi
        created_log="$(echo "$created_log" | jq --arg id "$created_id" --arg name "$name" '. + [{"id": $id, "name": $name}]')"
        save_tx
        migrated_count=$((migrated_count + 1))
    fi
done < <(echo "$items_json" | jq -c '.[]')

echo ""
if [[ "$MODE" == "plan" ]]; then
    echo "[ OK ] Migration Plan Summary: Ready to migrate $migrated_count secrets from $SRC -> $DST."
    echo "[INFO] Run 'sec migrate --from $SRC --to $DST --apply' to execute migration."
else
    # Save final completed transaction log
    save_tx

    echo "[ OK ] Vault Migration Successfully Completed ($migrated_count items migrated)"
    echo "[INFO] Migration transaction log saved to $TX_FILE."
    echo "[INFO] If needed, run 'sec migrate --undo' to revert created items in '$DST'."
fi
