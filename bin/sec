#!/usr/bin/env bash
# bin/sec: Multi-Tenant Zero-Plaintext Secret Manager Wrapper & Auth/Auto-Rotate Engine
set -euo pipefail

VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$HOME/.sec"
CONFIG_FILE="$CONFIG_DIR/sec.conf"

mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR"

# Initialize default ~/.sec/sec.conf if missing
ensure_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        cat <<EOF > "$CONFIG_FILE"
# ~/.sec/sec.conf: Fleet Multi-Tenant Secret Manager Configuration
[global]
default_backend = bitwarden
auto_rotate = true

[bitwarden]
cli = bw
auto_rotate = true

[1pass]
cli = op
auto_rotate = false

[bws]
cli = bws
auto_rotate = true

[vault]
cli = vault
auto_rotate = false

[infisical]
cli = infisical
auto_rotate = false
EOF
        chmod 600 "$CONFIG_FILE"
    fi
}

ensure_config

# Helper to read INI config property
get_cfg_val() {
    local section="$1"
    local key="$2"
    local default_val="$3"
    awk -F '=' -v s="[$section]" -v k="$key" '
        $0 == s { in_s=1; next }
        /^\[/ { in_s=0 }
        in_s && $1 ~ k { gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; found=1; exit }
        END { if (!found) print "'"$default_val"'" }
    ' "$CONFIG_FILE" 2>/dev/null || echo "$default_val"
}

DEFAULT_BACKEND="$(get_cfg_val "global" "default_backend" "bitwarden")"

# Parse Tenant Prefix (e.g., 'sec 1pass get KEY' or 'sec bitwarden set KEY')
TARGET_TENANT=""
if [[ $# -ge 2 ]] && [[ "$1" =~ ^(bitwarden|bw|1pass|op|bws|vault|infisical|keychain)$ ]]; then
    TARGET_TENANT="$1"
    shift
fi

if [[ -z "$TARGET_TENANT" ]]; then
    TARGET_TENANT="$DEFAULT_BACKEND"
fi

# Ensure Authentication / Session Auto-Rotate for Target Tenant
ensure_tenant_auth() {
    local tenant="$1"
    local auto_rotate
    auto_rotate="$(get_cfg_val "$tenant" "auto_rotate" "true")"

    case "$tenant" in
        bitwarden|bw)
            if [[ "$auto_rotate" == "true" ]]; then
                if [[ -f "$HOME/.cache/bitwarden/session" ]] && [[ -s "$HOME/.cache/bitwarden/session" ]]; then
                    export BW_SESSION="$(cat "$HOME/.cache/bitwarden/session")"
                fi
            fi

            local status_val
            status_val="$(BW_SESSION="${BW_SESSION:-}" bw status 2>/dev/null | jq -r '.status // "unauthenticated"')"

            if [[ "$status_val" != "unlocked" ]]; then
                if [[ "$auto_rotate" == "true" ]] && [[ -x "$SCRIPT_DIR/bw-session-keeper" ]]; then
                    echo "[sec] Session expired. Executing auto-rotation for Bitwarden..." >&2
                    "$SCRIPT_DIR/bw-session-keeper" rotate >/dev/null 2>&1 || true
                    if [[ -f "$HOME/.cache/bitwarden/session" ]]; then
                        export BW_SESSION="$(cat "$HOME/.cache/bitwarden/session")"
                    fi
                fi
            fi

            status_val="$(BW_SESSION="${BW_SESSION:-}" bw status 2>/dev/null | jq -r '.status // "unauthenticated"')"
            if [[ "$status_val" != "unlocked" ]]; then
                if [[ "${SEC_NONINTERACTIVE:-0}" == "1" ]]; then
                    return 1
                fi
                echo "[sec] Bitwarden vault is locked. Prompting for interactive unlock..." >&2
                if [[ -x "$SCRIPT_DIR/bw-session-keeper" ]]; then
                    "$SCRIPT_DIR/bw-session-keeper" unlock
                    if [[ -f "$HOME/.cache/bitwarden/session" ]]; then
                        export BW_SESSION="$(cat "$HOME/.cache/bitwarden/session")"
                    fi
                fi
            fi
            ;;
        1pass|op)
            if ! op account list >/dev/null 2>&1; then
                echo "[sec] 1Password is locked. Prompting for interactive signin..." >&2
                eval $(op signin)
            fi
            ;;
        vault)
            if ! vault token lookup >/dev/null 2>&1; then
                echo "[sec] HashiCorp Vault token expired. Prompting for login..." >&2
                vault login
            fi
            ;;
    esac
}

usage() {
    echo "sec-cli v$VERSION — Multi-Tenant Zero-Plaintext Secret Manager & Housekeeper"
    echo "Config File: ~/.sec/sec.conf (Default Tenant: $DEFAULT_BACKEND)"
    echo ""
    echo "Usage:"
    echo "  sec [<tenant>] get <key>                 Retrieve secret value from tenant or default vault"
    echo "  sec [<tenant>] get <item>/<field>        Retrieve specific field from named vault item (e.g. 'github/password')"
    echo "  sec [<tenant>] set <key> [<val>]         Store / create new secret in tenant vault (prompts if <val> omitted)"
    echo "  sec [<tenant>] run -- <cmd>              Execute command with tenant secrets injected into process memory"
    echo "  sec housekeep {plan|apply|revert}        Intelligent ML categorization, plan/apply, & instant rollback engine"
    echo "  sec migrate --from <src> --to <dst>     Zero-plaintext vault-to-vault migration engine"
    echo "  sec unlock                               Unlock Bitwarden vault and save session"
    echo "  sec rotate                               Keep-alive / rotate Bitwarden session key"
    echo "  sec setup-keychain                       Store master password in Keychain for auto-rotation"
    echo "  sec completion {zsh|bash|ps1}            Generate shell autocompletion scripts"
    echo ""
    echo "Flags:"
    echo "  -h, --help     Display this help menu"
    echo "  -v, --version  Display version"
    echo ""
    echo "Configured Tenants: bitwarden (bw), 1pass (op), bws, vault, infisical, keychain"
    exit 0
}

if [[ $# -lt 1 ]]; then usage; fi

cmd="$1"; shift

case "$cmd" in
    -h|--help|help)
        usage
        ;;
    -v|--version|version)
        echo "sec-cli version $VERSION"
        exit 0
        ;;
    completion)
        shell="${1:-zsh}"
        case "$shell" in
            zsh)
                cat <<'EOF'
#compdef sec

_sec() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    local -a tenants=(bitwarden bw 1pass op bws vault infisical keychain)
    local -a subcommands=(
        'get:Retrieve secret value from vault'
        'set:Store / create a new secret in vault'
        'run:Execute command with vault secrets injected into memory'
        'housekeep:Intelligent ML categorization, plan/apply, & instant rollback'
        'migrate:Zero-plaintext vault-to-vault migration engine'
        'unlock:Unlock Bitwarden vault and save session'
        'rotate:Keep-alive / rotate Bitwarden session key'
        'setup-keychain:Store master password in Keychain for auto-rotation'
        'completion:Generate shell autocompletion script'
    )

    _arguments -C \
        '(-h --help)'{-h,--help}'[Display help menu]' \
        '(-v --version)'{-v,--version}'[Display version]' \
        '1:subcommand or tenant:->cmd_or_tenant' \
        '*::arg:->args'

    case $state in
        cmd_or_tenant)
            _describe -t subcommands 'sec commands' subcommands
            _describe -t tenants 'vault tenants' tenants
            ;;
        args)
            case $words[1] in
                housekeep|organize)
                    local -a hk_cmds=('plan:Generate ML categorization plan' 'apply:Execute organization with pre-apply backup' 'revert:Rollback last housekeeping operation')
                    _describe -t hk_cmds 'housekeep commands' hk_cmds
                    ;;
                migrate)
                    _arguments \
                        '--from[Source vault backend]:backend:(bitwarden 1password bws vault infisical)' \
                        '--to[Target vault backend]:backend:(bitwarden 1password bws vault infisical)' \
                        '--plan[Generate migration plan]' \
                        '--apply[Execute vault migration]' \
                        '--undo[Rollback partially migrated items]'
                    ;;
                completion)
                    local -a shells=('zsh:Zsh completion' 'bash:Bash completion' 'ps1:PowerShell completion')
                    _describe -t shells 'shells' shells
                    ;;
            esac
            ;;
    esac
}

compdef _sec sec
EOF
                exit 0
                ;;
            bash)
                cat <<'EOF'
_sec_bash_completion() {
    local cur prev subcmds tenants
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    subcmds="get set run housekeep migrate unlock rotate setup-keychain completion --help -h --version -v"
    tenants="bitwarden bw 1pass op bws vault infisical keychain"

    if [[ ${COMP_CWORD} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "${subcmds} ${tenants}" -- ${cur}) )
        return 0
    fi

    case "${COMP_WORDS[1]}" in
        housekeep|organize)
            COMPREPLY=( $(compgen -W "plan apply revert" -- ${cur}) )
            ;;
        migrate)
            COMPREPLY=( $(compgen -W "--from --to --plan --apply --undo" -- ${cur}) )
            ;;
        completion)
            COMPREPLY=( $(compgen -W "zsh bash fish ps1" -- ${cur}) )
            ;;
    esac
}
complete -F _sec_bash_completion sec
EOF
                exit 0
                ;;
            fish)
                cat <<'EOF'
# Fish completion for sec-cli
function __fish_sec_needs_command
    set cmd (commandline -opc)
    if [ (count $cmd) -eq 1 ]
        return 0
    end
    return 1
end

complete -f -c sec -n '__fish_sec_needs_command' -a 'get' -d 'Retrieve secret value from vault'
complete -f -c sec -n '__fish_sec_needs_command' -a 'set' -d 'Store / create a new secret in vault'
complete -f -c sec -n '__fish_sec_needs_command' -a 'run' -d 'Execute command with vault secrets injected'
complete -f -c sec -n '__fish_sec_needs_command' -a 'housekeep' -d 'Intelligent ML categorization plan/apply/revert'
complete -f -c sec -n '__fish_sec_needs_command' -a 'migrate' -d 'Zero-plaintext vault-to-vault migration engine'
complete -f -c sec -n '__fish_sec_needs_command' -a 'unlock' -d 'Unlock Bitwarden vault and save session'
complete -f -c sec -n '__fish_sec_needs_command' -a 'rotate' -d 'Keep-alive / rotate Bitwarden session key'
complete -f -c sec -n '__fish_sec_needs_command' -a 'setup-keychain' -d 'Store master password in Keychain'
complete -f -c sec -n '__fish_sec_needs_command' -a 'completion' -d 'Generate shell autocompletion script'

complete -f -c sec -n '__fish_seen_subcommand_from housekeep' -a 'plan apply revert'
complete -f -c sec -n '__fish_seen_subcommand_from migrate' -a '--from --to --plan --apply --undo'
complete -f -c sec -n '__fish_seen_subcommand_from completion' -a 'zsh bash fish ps1'
EOF
                exit 0
                ;;
            ps1|powershell)
                cat <<'EOF'
# PowerShell completion for sec-cli
Register-ArgumentCompleter -Native -CommandName 'sec', 'sec.exe', 'sec.ps1' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)

    $subcommands = @('get', 'set', 'run', 'housekeep', 'migrate', 'unlock', 'rotate', 'setup-keychain', 'completion')
    $tenants = @('bitwarden', 'bw', '1pass', 'op', 'bws', 'vault', 'infisical', 'keychain')

    $elements = $commandAst.ArgumentElements
    if ($elements.Count -le 1) {
        $subcommands + $tenants | Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
            [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
        }
    } elseif ($elements[1].Value -in @('housekeep', 'organize')) {
        @('plan', 'apply', 'revert') | Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
            [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
        }
    } elseif ($elements[1].Value -eq 'migrate') {
        @('--from', '--to', '--plan', '--apply', '--undo') | Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
            [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
        }
    } elseif ($elements[1].Value -eq 'completion') {
        @('zsh', 'bash', 'fish', 'ps1') | Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
            [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
        }
    }
}
EOF
                exit 0
                ;;
        esac
        ;;

    get)
        if [[ $# -lt 1 ]]; then usage; fi
        key="$1"
        ensure_tenant_auth "$TARGET_TENANT"

        if [[ "$key" =~ ^op:// ]]; then
            if command -v op >/dev/null 2>&1; then
                op read "$key" 2>/dev/null && exit 0
            fi
        fi

        case "$TARGET_TENANT" in
            bitwarden|bw)
                if command -v bw >/dev/null 2>&1; then
                    # 1. Check for exact item name match $key
                    items_json="$(BW_SESSION="${BW_SESSION:-}" bw list items --search "$key" 2>/dev/null || true)"
                    count="$(echo "$items_json" | jq '. | length' 2>/dev/null || echo 0)"
                    if [[ "$count" -ge 1 ]]; then
                        item="$(echo "$items_json" | jq --arg name "$key" '[.[] | select(.name == $name)][0] // empty')"
                        if [[ -n "$item" && "$item" != "null" ]]; then
                            res="$(echo "$item" | jq -r '.notes // .login.password // .card.number // .identity.ssn // .identity.email // empty')"
                            if [[ -n "$res" ]]; then echo "$res"; exit 0; fi
                        fi

                        # Check if $key matches a custom field on any searched item
                        cf_res="$(echo "$items_json" | jq -r --arg f "$key" '[.[] | .fields[]? | select(.name == $f).value // empty][0] // empty')"
                        if [[ -n "$cf_res" && "$cf_res" != "null" ]]; then echo "$cf_res"; exit 0; fi
                    else
                        # Fallback: Search custom fields across all vault items
                        all_items="$(BW_SESSION="${BW_SESSION:-}" bw list items 2>/dev/null || true)"
                        cf_res="$(echo "$all_items" | jq -r --arg f "$key" '[.[] | .fields[]? | select(.name == $f).value // empty][0] // empty')"
                        if [[ -n "$cf_res" && "$cf_res" != "null" ]]; then echo "$cf_res"; exit 0; fi
                    fi

                    # 2. If exact match not found and key contains slash, treat as <item_name>/<field_name>
                    if [[ "$key" == *"/"* ]]; then
                        item_name="${key%/*}"
                        field_name="${key##*/}"

                        # Check for attachment subpath: e.g. <item_name>/attachment/<filename>
                        if [[ "$item_name" == *"/"* ]] && [[ "${item_name##*/}" == "attachment" ]]; then
                            real_item_name="${item_name%/*}"
                            attachment_file="$field_name"
                            item_id="$(BW_SESSION="${BW_SESSION:-}" bw list items --search "$real_item_name" 2>/dev/null | jq -r --arg n "$real_item_name" '[.[] | select(.name == $n)][0].id // empty')"
                            if [[ -n "$item_id" ]]; then
                                BW_SESSION="${BW_SESSION:-}" bw get attachment "$attachment_file" --itemid "$item_id" --raw 2>/dev/null && exit 0
                            fi
                        fi

                        items_json="$(BW_SESSION="${BW_SESSION:-}" bw list items --search "$item_name" 2>/dev/null || true)"
                        count="$(echo "$items_json" | jq '. | length' 2>/dev/null || echo 0)"
                        if [[ "$count" -ge 1 ]]; then
                            # Extract field across all items matching item_name
                            res="$(echo "$items_json" | jq -r --arg n "$item_name" --arg f "$field_name" '
                                [.[] | select(.name == $n)] | map(
                                    if $f == "password" or $f == "pass" then .login.password
                                    elif $f == "username" or $f == "user" then .login.username
                                    elif $f == "notes" or $f == "note" then .notes
                                    elif $f == "totp" or $f == "2fa" then .login.totp
                                    elif $f == "uri" or $f == "url" then (.login.uris[0].uri // empty)
                                    elif $f == "number" or $f == "card_number" or $f == "card" then .card.number
                                    elif $f == "code" or $f == "cvv" or $f == "cvc" then .card.code
                                    elif $f == "cardholder" or $f == "cardholderName" then .card.cardholderName
                                    elif $f == "expMonth" or $f == "exp_month" then .card.expMonth
                                    elif $f == "expYear" or $f == "exp_year" then .card.expYear
                                    elif $f == "brand" then .card.brand
                                    elif $f == "ssn" then .identity.ssn
                                    elif $f == "email" then .identity.email
                                    elif $f == "phone" then .identity.phone
                                    elif $f == "firstName" or $f == "first_name" then .identity.firstName
                                    elif $f == "lastName" or $f == "last_name" then .identity.lastName
                                    elif $f == "passport" or $f == "passportNumber" then .identity.passportNumber
                                    elif $f == "license" or $f == "licenseNumber" then .identity.licenseNumber
                                    else (.fields[]? | select(.name == $f).value // empty)
                                    end // empty
                                ) | map(select(. != null and . != "")) | .[0] // empty
                            ')"
                            if [[ -n "$res" && "$res" != "null" ]]; then echo "$res"; exit 0; fi
                        fi
                    fi
                fi
                ;;
            1pass|op)
                if command -v op >/dev/null 2>&1; then
                    if res="$(op read "op://private/$key/password" 2>/dev/null || op read "op://private/$key/notes" 2>/dev/null)"; then
                        if [[ -n "$res" ]]; then echo "$res"; exit 0; fi
                    fi
                    if [[ "$key" == *"/"* ]]; then
                        item_name="${key%/*}"
                        field_name="${key##*/}"
                        if res="$(op read "op://private/$item_name/$field_name" 2>/dev/null)"; then
                            if [[ -n "$res" ]]; then echo "$res"; exit 0; fi
                        fi
                    fi
                fi
                ;;
            bws)
                if command -v bws >/dev/null 2>&1; then
                    res="$(bws secret get "$key" --value-only 2>/dev/null || true)"
                    if [[ -n "$res" ]]; then echo "$res"; exit 0; fi
                fi
                ;;
            vault)
                if command -v vault >/dev/null 2>&1; then
                    f="${field_name:-value}"
                    vault kv get -field="$f" "secret/data/$item_name" 2>/dev/null && exit 0
                fi
                ;;
            infisical)
                if command -v infisical >/dev/null 2>&1; then
                    infisical secrets get "$key" --plain 2>/dev/null && exit 0
                fi
                ;;
        esac

        echo "[sec] Error: Secret '$key' not found in tenant '$TARGET_TENANT'." >&2
        exit 1
        ;;

    set|create)
        if [[ $# -lt 1 ]]; then usage; fi

        ITEM_TYPE="1" # Default: Login (1), SecureNote (2), Card (3), Identity (4)
        if [[ "$1" == "--type" ]]; then
            type_str="$2"; shift 2
            case "$type_str" in
                note|securenote|2) ITEM_TYPE="2" ;;
                card|creditcard|3) ITEM_TYPE="3" ;;
                identity|4)        ITEM_TYPE="4" ;;
                login|1|*)         ITEM_TYPE="1" ;;
            esac
        fi

        if [[ $# -lt 1 ]]; then usage; fi
        key="$1"; shift || true
        value="${1:-}"
        ensure_tenant_auth "$TARGET_TENANT"

        if [[ -z "$value" ]]; then
            read -rsp "Enter secret value for '$key' ($TARGET_TENANT): " value
            echo ""
        fi

        case "$TARGET_TENANT" in
            bitwarden|bw)
                target_item_name="$key"
                update_field=""

                # Check if $key specifies <item_name>/<field_name> for a field-level update
                if [[ "$key" == *"/"* ]]; then
                    check_item="${key%/*}"
                    check_field="${key##*/}"
                    items_check="$(BW_SESSION="${BW_SESSION:-}" bw list items --search "$check_item" 2>/dev/null || true)"
                    has_item="$(echo "$items_check" | jq -r --arg n "$check_item" '[.[] | select(.name == $n)][0].id // empty' 2>/dev/null || true)"
                    if [[ -n "$has_item" && "$has_item" != "null" ]]; then
                        target_item_name="$check_item"
                        update_field="$check_field"
                    fi
                fi

                # Check if target item already exists
                items_json="$(BW_SESSION="${BW_SESSION:-}" bw list items --search "$target_item_name" 2>/dev/null || true)"
                existing_id="$(echo "$items_json" | jq -r --arg name "$target_item_name" '[.[] | select(.name == $name)][0].id // empty' 2>/dev/null || true)"
                if [[ -n "$existing_id" && "$existing_id" != "null" ]]; then
                    existing_item="$(BW_SESSION="${BW_SESSION:-}" bw get item "$existing_id" 2>/dev/null || true)"
                    if [[ -n "$existing_item" ]]; then
                        if [[ -n "$update_field" ]]; then
                            encoded="$(echo "$existing_item" | jq --arg f "$update_field" --arg val "$value" '
                                if $f == "username" or $f == "user" then .login.username = $val
                                elif $f == "password" or $f == "pass" then .login.password = $val
                                elif $f == "totp" or $f == "2fa" then .login.totp = $val
                                elif $f == "notes" or $f == "note" then .notes = $val
                                else
                                    .fields = (
                                        if (.fields | map(select(.name == $f)) | length) > 0 then
                                            .fields | map(if .name == $f then .value = $val else . end)
                                        else
                                            .fields + [{"type": 0, "name": $f, "value": $val}]
                                        end
                                    )
                                end
                            ' | bw encode 2>/dev/null || true)"
                        else
                            encoded="$(echo "$existing_item" | jq --arg val "$value" '.notes=$val | .login.password=$val' | bw encode 2>/dev/null || true)"
                        fi

                        if [[ -n "$encoded" ]] && BW_SESSION="${BW_SESSION:-}" bw edit item "$existing_id" "$encoded" >/dev/null 2>&1; then
                            echo "[sec] Secret '$key' updated in Bitwarden Vault."
                            exit 0
                        fi
                    fi
                fi

                # Create new item with specified type
                encoded="$(BW_SESSION="${BW_SESSION:-}" bw get template item 2>/dev/null | jq --arg name "$key" --arg val "$value" --argjson type "$ITEM_TYPE" '
                    .name=$name | .type=$type | .notes=$val |
                    if $type == 1 then .login.password=$val
                    elif $type == 3 then .card.number=$val
                    elif $type == 4 then .identity.ssn=$val
                    else .
                    end
                ' | bw encode 2>/dev/null || true)"
                if [[ -n "$encoded" ]]; then
                    if BW_SESSION="${BW_SESSION:-}" bw create item "$encoded" >/dev/null 2>&1; then
                        echo "[sec] Secret '$key' saved to Bitwarden Vault."
                        exit 0
                    fi
                fi
                ;;
            1pass|op)
                if op item create --category=password --title="$key" "password=$value" >/dev/null 2>&1; then
                    echo "[sec] Secret '$key' saved to 1Password."
                    exit 0
                fi
                ;;
            bws)
                proj_id="$(bws project list 2>/dev/null | jq -r '.[0].id // empty')"
                if [[ -n "$proj_id" ]]; then
                    if bws secret create "$key" "$value" "$proj_id" >/dev/null 2>&1; then
                        echo "[sec] Secret '$key' saved to Bitwarden Secrets Manager."
                        exit 0
                    fi
                fi
                ;;
        esac
        ;;

    run)
        if [[ $# -lt 1 ]]; then usage; fi
        if [[ "$1" == "--" ]]; then shift; fi
        ensure_tenant_auth "$TARGET_TENANT"

        case "$TARGET_TENANT" in
            bws)        exec bws run -- "$@" ;;
            1pass|op)   exec op run -- "$@" ;;
            infisical)  exec infisical run -- "$@" ;;
            *)          exec "$@" ;;
        esac
        ;;

    housekeep|organize)
        if [[ -x "$SCRIPT_DIR/sec-organizer" ]]; then
            exec "$SCRIPT_DIR/sec-organizer" "${1:-plan}"
        fi
        ;;

    migrate)
        if [[ -x "$SCRIPT_DIR/sec-migrator" ]]; then
            exec "$SCRIPT_DIR/sec-migrator" "$@"
        fi
        ;;

    unlock|rotate|keep|setup-keychain)
        if [[ -x "$SCRIPT_DIR/bw-session-keeper" ]]; then
            exec "$SCRIPT_DIR/bw-session-keeper" "$cmd" "$@"
        fi
        ;;

    *)
        usage
        ;;
esac
